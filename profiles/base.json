  "presets": {
    "layouts": {
      "by-owner": "{entity_type}/{entity}/{topic}/{year}",
      "by-year": "{year}/{entity_type}/{entity}/{topic}",
      "media": "{kind}/{year}/{month}",
      "classic-numbered": "{group_label}/{entity}/{topic_top}"
    },
    "naming": {
      "dated": "{date}_{entity_tag}_{title}",
      "original": "{original}",
      "id-docs": "{entity_tag}_{doc_type}_{title}",
      "invoice": "{date}_{vendor}_Invoice_{amount}_{title}",
      "screenshot": "{date}_{time}_Screenshot"
    },
    "month_format": "{mm}-{MonthName}",
    "naming_by_type": {
      "tag:id": "id-docs",
      "Invoice": "invoice",
      "Receipt": "invoice",
      "Screenshot": "screenshot"
    },
    "naming_kinds": [
      "PDF",
      "Document",
      "Spreadsheet",
      "Presentation",
      "Email"
    ],
    "_naming_about": "Sorter renaming (only when ticked): 'original' = never rename. Types in naming_by_type get their own style; other documents (naming_kinds, or any file with a detected document type) get the chosen style; plain photos, videos and audio keep their names."
  },
  "ui": {
    "port": 8765,
    "idle_hours": 4,
    "bind": "127.0.0.1",
    "lan": {
      "enabled": false,
      "port": 8766,
      "_about": "phones/tablets on home Wi-Fi: HTTPS, private addresses only, each device approved on the computer"
    }
  },
  "naming_preset": "original",
  "insights": {
    "_about": "Learning, recommendations, pattern report and missing-document alerts. Proposals are never applied without approval.",
    "expected_docs": {},
    "annual_docs": {},
    "year_start_month": 1,
    "annual_due_month": 4,
    "annual_lookback_years": 5,
    "expiry_doc_types": [
      "Passport",
      "Driving licence",
      "Insurance policy",
      "Vehicle RC"
    ],
    "expiry_patterns": [
      "(?:date of expiry|expiry date|date of expiration|valid (?:till|upto|up to|until)|expires? on|policy end date|end date|maturity date|validity)[^0-9]{0,30}(\\d{1,2}[/.-]\\d{1,2}[/.-]\\d{2,4}|\\d{1,2}[ -]?[A-Za-z]{3,9}[ -,]*\\d{4})"
    ],
    "date_order": "dmy",
    "expiry_warn_days": 180,
    "series": {
      "min_docs": 4,
      "min_gap_days": 20,
      "max_gap_days": 400,
      "regularity": 0.75,
      "overdue_factor": 2.0,
      "active_years": 2
    },
    "recommendations": {
      "large_file_mb": 500,
      "large_old_years": 2,
      "screenshot_old_months": 6,
      "downloads_old_days": 180
    },
    "folder_consensus": {
      "min_owned": 3,
      "purity": 0.9,
      "coverage": 0.5
    },
    "mining": {
      "min_support": 3,
      "precision": 0.9,
      "min_len": 4,
      "stopwords": "scan scanned copy final draft new old file files document documents doc docs page pages image images photo photos img pdf jpeg jpg png heic screenshot screen shot recording video audio part front back side signed sign version updated update latest original edited compressed with from that this have your their 2fa jan feb mar apr may jun jul aug sep oct nov dec january february march april june july august september october november december organized sort media archive archives misc other others personal family office desktop downloads users library mobile clouddocs"
    },
    "auto_report": true
  },
  "sorter": {
    "_about": "Moves files only after a previewed, approved plan. Every run is logged and can be undone.",
    "sources": [
      "{LIBRARY}/{Unsorted}"
    ],
    "owner_confidence": {
      "auto": [
        "high",
        "you"
      ],
      "ask": [
        "medium"
      ]
    },
    "learn_from_library": true,
    "learn_min_share": 0.6,
    "learn_min_files": 2,
    "topic_fallback": "Misc",
    "media_kinds": {
      "Photo": "Photos",
      "Video": "Videos",
      "Audio": "Audio"
    },
    "media_doc_types": {
      "Screenshot": "Screenshots",
      "Screen recording": "Screen Recordings"
    },
    "media_template": "{group:Media}/{media_folder}/{year}/{month}",
    "archive_template": "{LIBRARY}/{group:Archive}/{year}",
    "default_group_labels": {
      "Archive": "70_Archive",
      "Media": "Media",
      "Unsorted": "To Sort"
    },
    "local_only_folder": "{HOME}/Private (local only)",
    "remove_empty_folders": true,
    "max_errors": 25,
    "year_level_min": 30,
    "misc_names": [
      "Misc",
      "Others",
      "Other",
      "General",
      "Miscellaneous"
    ],
    "archive_after_years": 2,
    "archive_kinds": {
      "Code": "Code",
      "Installer": "Installers",
      "Archive": "Archives"
    }
  },
