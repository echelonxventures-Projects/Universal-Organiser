{
  "_about": "Base profile: generic rules for every computer. A region pack (profiles/regions/<name>.json) adds country documents; your own profile overrides anything. No personal names here.",
  "engine": {
    "mode": "read-only",
    "organisation_model": "hybrid",
    "network": "offline",
    "ai": {
      "apple_builtin": true,
      "ollama": {
        "enabled": false,
        "url": "http://127.0.0.1:11434",
        "model": ""
      },
      "cloud": "never"
    }
  },
  "catalogue": {
    "encrypted": true,
    "vault_size": "20g",
    "text": "full",
    "max_text_chars": 400000,
    "spotlight_also": true,
    "history": true
  },
  "entity_types": [
    "Self",
    "Family",
    "Friend",
    "Office",
    "Organisation",
    "Client",
    "Property",
    "Vehicle"
  ],
  "lifecycles": {
    "Permanent": null,
    "Temporary": "90d",
    "Testing": "30d"
  },
  "plugins": {
    "metadata": {
      "enabled": true
    },
    "hash": {
      "enabled": true,
      "full_hash_max_mb": 300
    },
    "text": {
      "enabled": true,
      "pdf_ocr_if_no_text": true,
      "pdf_ocr_pages": 3
    },
    "archive": {
      "enabled": true,
      "max_entries": 2000
    },
    "image_meta": {
      "enabled": true
    },
    "ocr": {
      "enabled": true,
      "max_mb": 40,
      "languages": [
        "en-US"
      ]
    },
    "image_classify": {
      "enabled": true,
      "min_confidence": 0.35,
      "max_labels": 6
    },
    "faces": {
      "enabled": true,
      "mode": "suggest-only"
    },
    "transcribe": {
      "enabled": true,
      "mode": "auto for speech files, others on demand",
      "languages": [
        "en-US"
      ],
      "max_minutes": 180,
      "auto_doc_types": [
        "Meeting recording",
        "Screen recording"
      ],
      "auto_entity_types": [
        "Office",
        "Client"
      ],
      "auto_exts": [
        "wav",
        "m4a",
        "amr",
        "opus",
        "aac",
        "caf"
      ],
      "skip_under": [
        "{HOME}/Music"
      ],
      "workers": 2,
      "_note": "on-device Apple SpeechTranscriber; a language model that is not installed is never downloaded automatically",
      "label_from_transcript": false,
      "_languages_note": "tried on a 60 s sample of each recording; the most confident one transcribes it. Any installed language can be chosen per file.",
      "keep_reserved": []
    },
    "doc_type": {
      "enabled": true
    },
    "entities": {
      "enabled": true
    },
    "topics": {
      "enabled": true
    },
    "near_duplicate_photos": {
      "enabled": true,
      "mode": "suggest-only",
      "max_distance": 0.3,
      "max_hamming": 12,
      "burst_seconds": 10,
      "max_distance_screens": 0.05,
      "_note": "calibrated 2026-11-13: camera photos <=0.3 are the same moment (bursts); screenshots look alike even when the content differs, so they must be ~identical",
      "min_pixels": 16384
    }
  },
  "kinds": {
    "Photo": "jpg jpeg png heic heif gif webp bmp tiff tif raw cr2 nef dng",
    "Video": "mp4 mov m4v avi mkv webm wmv flv 3gp",
    "Audio": "mp3 m4a wav aac flac ogg aiff opus",
    "PDF": "pdf",
    "Document": "doc docx rtf odt pages txt md",
    "Spreadsheet": "xls xlsx csv numbers ods",
    "Presentation": "ppt pptx key odp",
    "Web page": "html htm webarchive mhtml",
    "Archive": "zip rar 7z tar gz tgz bz2 xz",
    "Installer": "dmg pkg exe msi iso apk dll msu cab",
    "Code": "py js ts tsx jsx json css scss java c cpp h go rs rb php sh yml yaml toml lock ipynb sql xml svg",
    "Font": "ttf otf woff woff2",
    "Email": "eml msg mbox"
  },
  "text_extract": {
    "zip_xml": "docx xlsx pptx odt ods odp",
    "textutil": "doc rtf html htm webarchive",
    "plain": "txt md csv json xml yml yaml toml sql py js ts sh log",
    "pdf": "pdf"
  },
