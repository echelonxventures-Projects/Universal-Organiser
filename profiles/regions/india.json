{
  "_about": "India: identity and tax documents, April-March financial year, Indian English and Hindi speech.",
  "name": "India",
  "doc_types_insert": [
    {
      "before": "Passport",
      "type": {
        "name": "PAN card",
        "all_text": [
          "\\b[A-Z]{5}[0-9]{4}[A-Z]\\b"
        ],
        "any_text": [
          "income tax department",
          "permanent account number"
        ],
        "any_name": [
          "\\bpan\\b",
          "pancard",
          "pan card"
        ],
        "max_text_chars": 2500,
        "tags": [
          "id",
          "holder",
          "important",
          "paper"
        ]
      }
    },
    {
      "before": "Passport",
      "type": {
        "name": "Aadhaar",
        "all_text": [
          "\\b\\d{4}\\s\\d{4}\\s\\d{4}\\b"
        ],
        "any_text": [
          "aadhaar",
          "uidai",
          "unique identification",
          "आधार"
        ],
        "any_name": [
          "aadhaar",
          "aadhar"
        ],
        "max_text_chars": 2500,
        "tags": [
          "id",
          "holder",
          "dob",
          "important",
          "paper"
        ]
      }
    },
    {
      "before": "Vehicle RC",
      "type": {
        "name": "Voter ID",
        "any_text": [
          "election commission of india",
          "elector"
        ],
        "any_name": [
          "voter"
        ],
        "max_text_chars": 2500,
        "tags": [
          "id",
          "holder",
          "dob",
          "important",
          "paper"
        ]
      }
    },
    {
      "before": "Invoice",
      "type": {
        "name": "Form 16 / ITR",
        "any_text": [
          "form no\\.? ?16",
          "form 16",
          "acknowledgement number",
          "itr-\\d",
          "income tax return"
        ],
        "any_name": [
          "form ?16",
          "\\bitr\\b",
          "26as"
        ],
        "tags": [
          "money",
          "tax",
          "important",
          "paper"
        ]
      }
    },
    {
      "before": "Meeting recording",
      "type": {
        "name": "80G / 12A / FCRA",
        "any_text": [
          "80g",
          "12a",
          "fcra"
        ],
        "any_name": [
          "80g",
          "12a",
          "fcra"
        ],
        "tags": [
          "important"
        ]
      }
    }
  ],
  "doc_types_replace": {
    "Passport": {
      "name": "Passport",
      "any_text": [
        "republic of india.{0,40}passport",
        "passport no"
      ],
      "any_name": [
        "passport"
      ],
      "max_text_chars": 2500,
      "tags": [
        "id",
        "holder",
        "dob",
        "important",
        "paper"
      ]
    }
  },
